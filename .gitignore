# Chroma persistent store — derived, rebuilt by notebooks/3a.embed-index-canary.ipynb.
# The `*.db` rule above does NOT match it: the store is chroma.sqlite3 (plus -wal/-shm)
# and UUID-named subdirs of binary HNSW index files. Ignore the directory, not a pattern.
notebooks/.chroma/
